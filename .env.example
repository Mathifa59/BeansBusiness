# Plantilla de variables de entorno. Copiar a .env.local para desarrollo.
# En producción las mismas variables van en Vercel (proyecto > Settings >
# Environment Variables > Production) y hay que hacer Redeploy para aplicarlas:
# el sitio desplegado NO lee .env.local.

# Correo: SMTP del buzón que envía los correos del sitio (contacto y reclamos).
# Si se cambia la contraseña del buzón, actualizar SMTP_PASS en Vercel y redeploy.
SMTP_HOST=mail.businessbeans.com.pe
SMTP_PORT=465
SMTP_USER=comercial@businessbeans.com.pe
SMTP_PASS=

# Quién recibe los avisos (contacto y Libro de Reclamaciones).
# Varias direcciones separadas por coma, en una sola línea, sin comillas.
MAIL_TO=
